# 로컬 리허설용 — cp .env.local.example .env.local 후 그대로 사용 가능
# 서버 배포용 .env와 분리 (docs/local-test.md 참조)

POSTGRES_PASSWORD=local-pg-pass

# 인증 ON — 로컬 Keycloak(keycloak.local alias)으로 실제 로그인 흐름 리허설
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://keycloak.local:8080/realms/ai-portal
KEYCLOAK_AUDIENCE=
KEYCLOAK_CLIENT_ID=db-viewer-frontend
DEV_USER=dev.user
DBV_SYSADMINS=admin.sys
INGEST_API_KEY=local-ingest-key

# LDAP은 로컬에서 끔 — AD 전용 속성(sAMAccountName 등)이라 OpenLDAP으로 대체 불가.
# 꺼져 있으면 동기화만 비활성(로그인 시 스킵, /admin 동기화 503) — 정상 동작.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=
LDAP_START_TLS=false
LDAP_CA_BUNDLE=

# 데이터 소스 / 튜닝 — 서버 기본값과 동일
SOURCE_MODE=fixture
FIXTURE_DIR=fixtures
LINEAGE_DEPTH_LIMIT=10
SCAN_MAX_CONCURRENT=2
SCAN_FULL_RECHECK_TOP=20
SCAN_MIN_CONTAINMENT=0.9
SCAN_NIGHT_START_HOUR=20
SCAN_NIGHT_END_HOUR=6
LOW_CARDINALITY_MIN_DISTINCT=50
LOW_CARDINALITY_BLACKLIST=["USE_YN","DEL_YN","STATUS_CD","TYPE_CD","KIND_CD","UNIT_CD"]

# --profile collect (MSSQL·n8n 수집 리허설) 사용 시
MSSQL_SA_PASSWORD=Local!Passw0rd
