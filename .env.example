# 복사해서 .env로 사용 — .env는 커밋 금지 / copy to .env; never commit .env
#
# 배포 좌표 / deployment endpoints
#   앱(단일 포트, UI + /api 프록시): http://182.199.63.71:6678
#   n8n:                             http://182.199.63.71:5678
#   n8n 워크플로 env: DB_VIEWER_API_BASE=http://182.199.63.71:6678

# compose용 Postgres 비밀번호 — DATABASE_URL은 compose가 조립한다
POSTGRES_PASSWORD=change-me

# Service DB (PostgreSQL 16) 접속 URL — 로컬 직접 실행용 / local non-compose runs
# 형식: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://dbviewer:change-me@localhost:5432/dbviewer

# 데이터 소스 모드 — fixture | replay | live / data source mode
# live는 사내 보안 승인 후에만 켠다 (Phase 3 게이트) / live only after security approval
SOURCE_MODE=fixture

# ── 인증 (bpm 패턴 — 백/프론트 플래그는 compose가 AUTH_ENABLED 하나로 함께 주입) ──
AUTH_ENABLED=false
# Keycloak 클라이언트 — realm ai-portal에 public client로 등록, redirect URI: http://182.199.63.71:6678/*
KEYCLOAK_CLIENT_ID=db-viewer-frontend
KEYCLOAK_ISSUER=http://182.199.63.71:8080/realms/ai-portal
# 빈 값이면 aud 검증 생략 (Keycloak 기본 토큰은 aud=account)
KEYCLOAK_AUDIENCE=
DEV_USER=dev.user
# 시스템관리자 login_id 콤마 목록 — 화이트리스트 우회 + /api/admin 접근
DBV_SYSADMINS=
# n8n W1이 X-API-Key 헤더로 보내는 값 — auth 켜면 필수 / required once auth is on
INGEST_API_KEY=
# n8n webhook 베이스 — 버튼 수집(W1a/b) + live 검증·미리보기(W2) 공용 (예: http://182.199.63.71:5678/webhook)
N8N_WEBHOOK_BASE=
# n8n 쿼리 응답 대기 상한(초) — W1 수집·W2 검증 공용
N8N_QUERY_TIMEOUT=120

# ── AI (사내 LLM — OpenAI 호환 /v1/chat/completions) ── 비우면 결정론적 목업 동작
# 베이스 URL (예: http://<llm-host>:11434/v1)
AI_BASE_URL=
# 모델명 — LLM 서버에 로드된 이름 그대로
AI_MODEL=
# API 키 — 무인증 서버면 비워둔다
AI_API_KEY=
# LLM 응답 대기 상한(초)
AI_TIMEOUT=60
# LLM 재판정 후보 페어 상한
AI_SUGGEST_MAX_PAIRS=40

# ── 임베딩 서버 (bge-m3 등 OpenAI 호환 /embeddings, 인증 없음) ── 비우면 의미 검색 비활성
# 채팅 LLM과 다른 호스트일 수 있어 별도 설정이다. 채팅 LLM(AI_BASE_URL) 없이도 동작한다.
# 변수명은 사내 다른 임베딩 사용 서비스와 동일 — 그쪽 .env 값을 그대로 복사하면 된다.
# URL은 /v1 루트·/embeddings 전체 경로 모두 허용
EMBED_URL=
EMBED_MODEL=bge-m3
# 임베딩 응답 대기 상한(초) — 채팅보다 짧다
EMBED_TIMEOUT_SECONDS=30
# 배치당 텍스트 수 / texts per embedding batch
AI_EMBED_BATCH=32
# 인덱싱 잡 상한 — 사용자 부하 제약 (2000 초과 금지) / indexing job cap
AI_EMBED_JOB_CAP=1000
# 배치 간 대기(ms) — 사용자 요청 우선 / inter-batch sleep
AI_EMBED_SLEEP_MS=500

# ── 수집 분할 (실측 2,342 테이블 대응 — 소스 DB 부하·전송 크기 관리) ──
# 객체 페이지 크기 — 이 단위로 객체→컬럼→키 캐스케이드를 돈다 / objects per page
COLLECT_CATALOG_CHUNK_SIZE=300
# 뷰 배치 크기 — DMV 커서 1회 처리량 / views per view-deps query
COLLECT_DEPS_CHUNK_SIZE=100

# ── LDAP (AD 동기화) — 4개 모두 설정해야 켜진다 / all four required ──
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=
LDAP_START_TLS=false
# 사내 CA 번들 경로 — 비우면 시스템 신뢰 저장소 (인증서 검증은 항상 강제)
LDAP_CA_BUNDLE=

# lineage 재귀 상한 — 초과 뷰는 depth_exceeded 플래그 처리 (기본 10)
LINEAGE_DEPTH_LIMIT=10

# FakeJoinValidator가 읽는 픽스처 디렉터리 (fixture/replay 모드)
# 상대 경로는 실행 위치가 아니라 저장소 루트 기준 — `tools/fixture_gen.py --out fixtures`가
# 쓰는 위치와 일치한다. 컨테이너에서 쓰려면 마운트 지점을 절대 경로로 준다.
# fixture dir consumed by the fake validator; relative paths anchor to the repo root
FIXTURE_DIR=fixtures

# T3 탐색 스캔 튜닝 (계획 §4) / exploratory scan tuning
SCAN_MAX_CONCURRENT=2
SCAN_FULL_RECHECK_TOP=20
SCAN_MIN_CONTAINMENT=0.9
# 야간 실행 창 (시) — night_only 잡은 이 창에서만 기동
SCAN_NIGHT_START_HOUR=20
SCAN_NIGHT_END_HOUR=6

# 저카디널리티 검증 제외 임계 — distinct < N 이면 검증 대상 제외 (계획 §3.3)
LOW_CARDINALITY_MIN_DISTINCT=50
# 공통 도메인 블랙리스트 — JSON 배열 / JSON array of always-excluded column names
LOW_CARDINALITY_BLACKLIST=["USE_YN","DEL_YN","STATUS_CD","TYPE_CD","KIND_CD","UNIT_CD"]
